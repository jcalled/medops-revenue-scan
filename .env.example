APP_ENV=dev

# Mesmo segredo e algoritmo do núcleo da plataforma (glosa_ai): o login é um só.
JWT_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais
JWT_ALG=HS256

# Núcleo da plataforma: confere, com o token do usuário, se o tenant contratou
# o Revenue Scan. No compose de produção, o serviço interno (ex.: http://api:8000).
CORE_API_URL=http://localhost:8000
# Quanto tempo a resposta do contrato vale antes de perguntar de novo.
ENTITLEMENT_CACHE_SECONDS=60

# Pode ser o mesmo Postgres do núcleo; as tabelas ficam no schema abaixo.
DATABASE_URL=postgresql+psycopg2://medops:medops@localhost:5432/medops
DB_SCHEMA=revenue_scan

REDIS_URL=redis://localhost:6379/0
RQ_QUEUE=revenue-scan

# Origens do frontend, separadas por vírgula.
CORS_ORIGINS=http://localhost:3000


INTERNAL_SERVICE_TOKEN=f4e51d2a2e6e0221b613639ab13c824d0ca1243e1aaba71c0ba34143d8d2cccc
# Alertas mensais por e-mail (opcional). Sem SMTP_HOST, os alertas ficam só na tela.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
# Endereço da plataforma, para os links dos alertas.
APP_URL=https://www.glosaai.com.br
